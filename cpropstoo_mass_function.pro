Function truncated_mass_function, x, p

; x - log mass of GMCs
; logN - the log number of GMCs with mass > x
; p - parameters used by mass function, more details see EQ. (6) 
;     in Utomo+ 2015
;   p[0] - N0, the number of clouds with M>2^(1/(x+1))M0
;   p[1] - M0, the cut-off mass of the distribution
;   p[2] - exponent of mass function - gamma

   numbers = n_elements(x)
   logN = make_array(numbers)*!values.f_nan
   for i = 0, numbers-1 do begin
     if (p[0]*((10.^x[i]/p[1])^(p[2]+1.)-1.)) gt 0 then begin
        logN[i]=alog10(p[0]*((10.^x[i]/p[1])^(p[2]+1.)-1.))
     endif else begin
        logN[i]=-1e9
     endelse
   endfor
   
   return, logN

End


Function notruncated_mass_function, x, p

; x - log mass of GMCs
; logN - the log number of GMCs with mass > x
; p - parameters used by mass function, more details see EQ. (7) 
;     in Utomo+ 2015
;   p[0] - M0, the cut-off mass of the distribution
;   p[1] - exponent of mass function - gamma

   logN=alog10((10.^x/p[0])^(p[1]+1.))
   
   return, logN

End


PRO cpropstoo_mass_function, infile=infile $
					   , inprop=inprop $
					   , intable = intable $
					   , minmass = minmass $
					   , dist_pc = dist_pc $
					   , xco = xco $
					   , inner_pc = inner_pc $
					   , outer_pc = outer_pc $
				       , ring_pc = ring_pc $
					   , notrunc = notrunc $
	                   , outfile=outfile
	                 

;+
; NAME: 
;   cpropstoo_mass_function
;
; PURPOSE:
;   Perform the mass function analysis
;  
;   
; INPUTS:
;   inprop   --  the '.idl' file for GMC properties generated by 'moments_to_props'
;   intable  --  the table of gmc properties generated by 'cpropsdist_gmc_table.pro'
;   minmass  --  the completeness level of mass function in log(Msun)
;   inner_pc --  the radius in [pc] for inner GMCs, i.e., r <= inner_pc
;   outer_pc --  vector of two elements for the radius in [pc] for outter GMCs, 
;				 i.e., outer_pc[0] < r < outer_pc[1]
;   ring_pc  --  vector of two elements for the ring radius in [pc], i.e., 
;                ring_pc[0] < r <= ring_pc[1]
;   notrunc  --  set this keyword to perform notrunc fitting
;    
; OUTPUTS:
;   outfile  --  the '.eps' file for output figure
; 
; HISTORY:
;   20170224  LJ   introduced


; HEAD MESSAGE
  print, '========================================'
  print, 'CPROPSTOO: GENERATE MASS FUNCTION PLOTS'
  print, '========================================'

; READ IN THE MLUM AND D_MLUM ARRAY
  ;props - a list of "this_props" for all clouds
  restore, inprop
  Mlum0=props.mass_extrap        ; in [Msun]
  d_Mlum0=props.mass_extrap_uc*Mlum0   ; in [Msun]

  logMlum0=alog10(Mlum0)
  d_logMlum0=1./alog(10.)*d_Mlum0/Mlum0

  ;distance - the distance from the galaxy center in [pc]
  readcol,intable, ID, RA, Dec, Vlsr, R, d_R, vrms, d_vrms, vturb, d_vturb, $
          Lum, d_Lum, Mlum, d_Mlum, Tmax, Omega_shear, Theta_shear,distance, $
          F='I, a, a, f, f, f, f, f, f, f, f, f, f, f, f, f, f, f'
  distance0=distance

  Mlum0=Mlum*1e5
  d_Mlum0=d_Mlum*1e5
  logMlum0=alog10(Mlum0) 
  d_logMlum0=1./alog(10.)*d_Mlum0/Mlum0

; SET COMPLETENESS LEVEL
  if n_elements(minmass) eq 0 then begin
	if (n_elements(dist_pc) eq 0) or (n_elements(xco) eq 0) then begin
		print, "PLEASE GIVE dist_pc AND xco !"
		return
	endif

    ; galaxy name
    galaxy=(strsplit(intable,'/',/extract))[-1]
    if (strmatch(galaxy,'*_*',/fold_case) eq 1) then begin
      galaxy=(strsplit(galaxy,'_',/extract))[0]
    endif
    if (strmatch(galaxy,'*.*',/fold_case) eq 1) then begin
      galaxy=(strsplit(galaxy,'.',/extract))[0]
    endif

	data = readfits(infile, hdr)
	rms = mad(data, /finite)      ; in 'K'
	dv = abs(sxpar(hdr, 'CDELT3'))  ; in 'km/s'
	fwhm = dv* 2.* sqrt(2.*alog(2.))
	bmaj_deg = sxpar(hdr, "BMAJ")
	bmaj_pc = bmaj_deg*!dtor*dist_pc
	bmin_deg = sxpar(hdr, "BMIN")
	bmin_pc = bmin_deg*!dtor*dist_pc
	beam = (bmaj_pc*bmin_pc)/4.*!pi/alog(2.) ; in 'pc^2'

	if galaxy eq 'NGC4429' then begin ; only apply to NGC4429
	  rms = 0.5  ; K
	  beam = 181 ; pc^2
	  dv = 2.    ; km/s
	  fwhm = dv* 2.* sqrt(2.*alog(2.))
	  xco = 4.66  ; Msun (K km/s pc^2)^-1
	endif
  endif

  resolve_ind = where(R gt 0.0)
  minmass = alog10(10.*rms*fwhm*xco*beam + min(Mlum0[resolve_ind]))
  print,'==================================='
  ;print,'rms',rms
  ;print,'beam',beam
  ;print,'dv',dv
  print,'xco',xco
  print, 'COMPLETENESS LIMIT:', minmass
  print,'==================================='


  complete_ind=where(Mlum0 ge 10.^minmass)
  Mlum=Mlum0[complete_ind]
  d_Mlum=d_Mlum0[complete_ind]
  logMlum=logMlum0[complete_ind]
  d_logMlum=d_logMlum0[complete_ind]
  distance=distance0[complete_ind]
  numbers=n_elements(logMlum)

; ==============================================
; METHOD:  Cumulative distribution
; ==============================================
  message, 'Method: Cumulative distribution', /con

; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;  1. Total GMCs
; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  ; N(M'>M) distribution
  N_tot0 = make_array(n_elements(Mlum0))
  for i = 0, n_elements(Mlum0)-1 do begin
	  theIndex = where(Mlum0 ge Mlum0[i], the_ct)
	  N_tot0[i]=the_ct
  endfor

  ; fit with a truncated cumulative distribution function 
  index = where(Mlum0 ge 10.^minmass, ct)
  xarrgood = Mlum0[index]
  xerrgood = d_Mlum0[index]
  trunc_result = mspecfit(xarrgood, xerrgood, bootiter = 100, error = error)
  print,'*********************************************************'
  print,'FIT WHOLE GALAXY'
  print,'TRUNCATED:'
  print,'N0, M0, gamma', trunc_result[0],trunc_result[1],trunc_result[2]
  print,'err_N0, err_M0, err_gamma', error[0], error[1], error[2]

  ; fit with a notruncated cumulative distribution function 
  if keyword_set(notrunc) then begin
      index = where(Mlum0 ge 10.^minmass, ct)
      xarrgood = Mlum0[index]
      xerrgood = d_Mlum0[index]
      notrunc_result = mspecfit(xarrgood, xerrgood, $
		  bootiter = 100, error = notrunc_error, /notrunc)
	  print,'POWER_LAW:'
	  print,'N0, gamma', notrunc_result[1],notrunc_result[2]
	  print,'err_N0, err_gamma', notrunc_error[1], notrunc_error[2]
	  print,'*********************************************************'
   endif

; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;  2. inner GMCs 
; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ; N(M'>M) distribution
  if n_elements(inner_pc) gt 0 then begin
	  inner_ind=where(distance0 le inner_pc)
	  Mlum1=Mlum0(inner_ind)
	  d_Mlum1=d_Mlum0(inner_ind)

      N_tot1 = make_array(n_elements(Mlum1))
      for i = 0, n_elements(Mlum1)-1 do begin
          theIndex = where(Mlum1 ge Mlum1[i], the_ct)
          N_tot1[i]=the_ct
      endfor
	
	  ; fit with a truncated cumulative distribution function for inner GMCs
	  index1 = where(Mlum1 ge 10.^minmass, ct)
	  xarrgood1 = Mlum1[index1]
	  xerrgood1 = d_Mlum1[index1]
	  trunc_result1 = mspecfit(xarrgood1, xerrgood1, bootiter = 100, $
		  error = error1)
      notrunc_result1 = mspecfit(xarrgood1, xerrgood1, $
		  bootiter = 100, error = notrunc_error1, /notrunc)
	  print,'*********************************************************'
	  print,'FIT INNER REGION:'
	  print,'TRUNCATED:'
	  print,'N0, M0, gamma', trunc_result1[0],trunc_result1[1],trunc_result1[2]
	  print,'err_N0, err_M0, err_gamma', error1[0], error1[1], error1[2]
	  print,'POWER_LAW:'
	  print,'N0, gamma', notrunc_result1[1],notrunc_result1[2]
	  print,'err_N0, err_gamma', notrunc_error1[1], notrunc_error1[2]
	  print,'*********************************************************'
  endif

; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;  3. ring GMCs 
; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ; N(M'>M) distribution
  if n_elements(ring_pc) gt 0 then begin
	  ring_ind=where((distance0 gt ring_pc[0]) and (distance0 le ring_pc[1]))
	  Mlum2=Mlum0(ring_ind)
	  d_Mlum2=d_Mlum0(ring_ind)

      N_tot2 = make_array(n_elements(Mlum2))
      for i = 0, n_elements(Mlum2)-1 do begin
          theIndex = where(Mlum2 ge Mlum2[i], the_ct)
          N_tot2[i]=the_ct
      endfor

	  index2 = where(Mlum2 ge 10.^minmass, ct)
	  xarrgood2 = Mlum2[index2]
	  xerrgood2 = d_Mlum2[index2]
	  trunc_result2 = mspecfit(xarrgood2, xerrgood2, bootiter = 100, $
		  error = error2)
      notrunc_result2 = mspecfit(xarrgood2, xerrgood2, $
		  bootiter = 100, error = notrunc_error2, /notrunc)
	  print,'*********************************************************'
	  print,'FIT INTERMEDIATE REGION:'
	  print,'TRUNCATED:'
	  print,'N0, M0, gamma', trunc_result2[0],trunc_result2[1],trunc_result2[2]
	  print,'err_N0, err_M0, err_gamma', error2[0], error2[1], error2[2]
	  print,'POWER_LAW:'
	  print,'N0, gamma', notrunc_result2[1],notrunc_result2[2]
	  print,'err_N0, err_gamma', notrunc_error2[1], notrunc_error2[2]
	  print,'*********************************************************'
  endif
	
; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;   4. outer GMCs 
; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ; N(M'>M) distribution
  if n_elements(outer_pc) gt 0 then begin
	  outer_ind=where((distance0 gt outer_pc[0]) and (distance0 le outer_pc[1]))
	  Mlum3=Mlum0(outer_ind)
	  d_Mlum3=d_Mlum0(outer_ind)

      N_tot3 = make_array(n_elements(Mlum3))
      for i = 0, n_elements(Mlum3)-1 do begin
          theIndex = where(Mlum3 ge Mlum3[i], the_ct)
          N_tot3[i]=the_ct
      endfor
	
	  index3 = where(Mlum3 ge 10.^minmass, ct)
	  xarrgood3 = Mlum3[index3]
	  xerrgood3 = d_Mlum3[index3]
	  trunc_result3 = mspecfit(xarrgood3, xerrgood3, bootiter = 100, $
		  error = error3)
      notrunc_result3 = mspecfit(xarrgood3, xerrgood3, $
		  bootiter = 100, error = notrunc_error3, /notrunc)
	  print,'*********************************************************'
	  print,'FIT OUTER REGION:'
	  print,'TRUNCATED:'
	  print,'N0, M0, gamma', trunc_result3[0],trunc_result3[1],trunc_result3[2]
	  print,'err_N0, err_M0, err_gamma', error3[0], error3[1], error3[2]
	  print,'POWER_LAW:'
	  print,'N0, gamma', notrunc_result3[1],notrunc_result3[2]
	  print,'err_N0, err_gamma', notrunc_error3[1], notrunc_error3[2]
	  print,'*********************************************************'
  endif

; ==============================================
; THE FINAL PLOT
; ==============================================
  set_plot, 'ps'
  device, filename=outfile, bits_per_pixel=8, /encapsulated, $
	  xsize=5., ysize=5., /inches, /color, xoffset=0, yoffset=0

  ; -------------------------------------------------
  ; I - MASS FUNCTION FOR WHOLE GALAXY
  ; -------------------------------------------------
  ; 1) PLOT ERROR N0 VS M0 FOR WHOLE GALAXY
  index=where((Mlum0 gt 0) and (N_tot0 gt 0), ct)
  yerr = make_array(ct)
  ;xmin = min(Mlum0[index]-d_Mlum0[index])
  ;xmin = 10.^(alog10(xmin) - 0.2)
  xmin = min(Mlum0)/10^0.1
  xmax = max(Mlum0[index]+d_Mlum0[index])*2.
  ymin = min(N_tot0[index])*0.8
  ymax = max(N_tot0[index])*10.^0.6
  ploterror, Mlum0[index], N_tot0[index], d_Mlum0[index], yerr, $
      psym=3, color='black', $
	  ;xtitle='M (M'+sunsymbol()+')', $
      ;ytitle='N (M$\prime$>M)', $
      position=[0.15,0.15,0.98,0.98], $
      hatlength=!D.X_VSIZE / 200., errthick = 2.0, errcolor='gray', $
      charsize = 1.7, xthick=5, ythick=5, charthick=5, $
      type=3, xrange=[xmin, xmax], $
      yrange=[ymin, ymax]
  cgtext, 0.05, 0.40, 'N (M$\prime$>M)', charsize = 1.8, $
          charthick=5.0, orientation = 90,/normal, $
          color = cgcolor('black')
  cgtext, 0.45, 0.03, 'M!Dgas!N (M'+sunsymbol()+')', charsize = 1.8, $
		  charthick=5.0, /normal, $
          color = cgcolor('black')
  plotsym, 0, 0.7, /fill
  ;oplot, Mlum0[index], N_tot0[index], psym=8

  ; 2) PLOT COMPLETENESS LIMIT
  yarr = 10.^(findgen(1e4)/1e4*(alog10(ymax)-alog10(ymin))+alog10(ymin))
  xarr = make_array(1e4, value=10.^minmass)
  ;print, 'completeness limit in plot', alog10(xarr[0])
  oplot, xarr, yarr, linestyle=2, thick = 4.
  cgtext, 10.^(minmass-0.05),1.5, 'completeness limit', /data, $
	  orientation=90., charsize=1.2, charthick=4.

  ; 3) PLOT TRUNC FIT CURVE
  linethick = 4
  xmin = min(Mlum0)* 10^0.1
  xarr = findgen(1e5)/1e5*(alog10(xmax)-alog10(xmin))+alog10(xmin)
  yarr = truncated_mass_function(xarr, trunc_result)
  loadct, 33, /silent
  oplot, 10.^xarr, 10.^yarr, linestyle=0, color=cgcolor('black'), thick=linethick
  loadct, 0, /silent

  ; 4) PLOT NOTRUNC FIT CURVE
  if keyword_set(notrunc) then begin
	  xarr = findgen(1e5)/1e5*(alog10(xmax)-alog10(xmin))+alog10(xmin)
	  notrunc_yarr = notruncated_mass_function(xarr, notrunc_result[1:2])
	  loadct, 33, /silent
	  oplot, 10.^xarr, 10.^notrunc_yarr, linestyle=2, $
			color=cgcolor('black'), thick=linethick
	  loadct, 0, /silent
  endif

   
  ; -------------------------------------------------
  ; II - MASS FUNCTION FOR DIFFERENT REGIONS
  ; -------------------------------------------------
  ; 1) PLOT DATA POINTS FOR INNER-REGION
  if n_elements(inner_pc) gt 0 then begin
	  index=where((Mlum1 gt 0) and (N_tot1 gt 0), ct)
	  yerr = make_array(ct)
	  oploterror, Mlum1[index], N_tot1[index], d_Mlum1[index], yerr, $
	      psym=3, color='blue', $
	      ;xtitle='M/M'+sunsymbol(), $
	      ;ytitle='N (M$\prime$>M)', $
	      hatlength=!D.X_VSIZE / 200., errthick = 2.0, errcolor='gray', $
	      ;charsize = 2.0, xthick=3, ythick=3, charthick=3, $
	      ;type=3, xrange=[xmin, xmax], $
	      yrange=[ymin, ymax]
	  plotsym, 0, 0.7, /fill
	  ;loadct, 33, /silent
	  ;oplot, Mlum1[index], N_tot1[index], psym=8, color=19
	  ;loadct, 0, /silent

	  loadct, 33, /silent
      xarr1 = findgen(1e5)/1e5*(alog10(xmax)-4.4)+4.4
	  yarr1 = truncated_mass_function(xarr1, trunc_result1)
	  oplot, 10.^xarr1, 10.^yarr1, linestyle=0, thick=linethick, color=19
	  notrunc_yarr1 = notruncated_mass_function(xarr1, notrunc_result1[1:2])
	  oplot, 10.^xarr1, 10.^notrunc_yarr1, linestyle=2, $
			color=19, thick=linethick
	  loadct, 0, /silent
  endif

  ; 2) PLOT DATA POINTS FOR RING-REGION
  if n_elements(ring_pc) gt 0 then begin
	  index=where((Mlum2 gt 0) and (N_tot2 gt 0), ct)
	  yerr = make_array(ct)
	  plotsym, 0, 0.7, /fill
	  if n_elements(inner_pc) gt 0 then begin
		  oploterror, Mlum2[index], N_tot2[index], d_Mlum2[index], yerr, $
		      psym=3, color='dark green', $
		      ;xtitle='M/M'+sunsymbol(), $
		      ;ytitle='N (M$\prime$>M)', $
		      hatlength=!D.X_VSIZE / 200., errthick = 2.0, errcolor='gray', $
		      ;charsize = 2.0, xthick=3, ythick=3, charthick=3, $
		      ;type=3, xrange=[1e5, xmax], $
		      yrange=[ymin, ymax]
	  endif else begin
		  ploterror, Mlum2[index], N_tot2[index], d_Mlum2[index], yerr, $
		      psym=3, color='dark green', $
		      xtitle='M/M'+sunsymbol(), $
		      ytitle='N (M$\prime$>M)', $
		      hatlength=!D.X_VSIZE / 200., errthick = 2.0, errcolor='gray', $
		      charsize = 2.0, xthick=3, ythick=3, charthick=3, $
		      type=3, xrange=[1e5, xmax], $
		      yrange=[ymin, ymax]
	  endelse
	  plotsym, 0, 0.7, /fill
	  ;oplot, Mlum2[index], N_tot2[index], psym=8, color=cgColor('dark green')
	
	  loadct, 33, /silent
      xarr2 = findgen(1e5)/1e5*(alog10(xmax)-4.4)+4.4
	  yarr2 = truncated_mass_function(xarr2, trunc_result2)
	  oplot, 10.^xarr2, 10.^yarr2, linestyle=0, thick=linethick, $
	  color=cgColor('dark green')
	  notrunc_yarr2 = notruncated_mass_function(xarr2, notrunc_result2[1:2])
	  oplot, 10.^xarr2, 10.^notrunc_yarr2, linestyle=2, $
			color=cgColor('dark green'), thick=linethick
	  loadct, 0, /silent
  endif

  ; 3) plot data points for outer-region
  if n_elements(outer_pc) gt 0 then begin
	  index=where((Mlum3 gt 0) and (N_tot3 gt 0), ct)
	  yerr = make_array(ct)
	  plotsym, 0, 0.7, /fill
	  if ((n_elements(inner_pc) le 0) and (n_elements(ring_pc) le 0)) then begin
		  ploterror, Mlum3[index], N_tot3[index], d_Mlum3[index], yerr, $
		      psym=3, color='red', $
		      ;xtitle='M/M'+sunsymbol(), $
		      ;ytitle='N (M$\prime$>M)', $
		      hatlength=!D.X_VSIZE / 200., errthick = 2.0, errcolor='gray', $
		      ;charsize = 2.0, xthick=3, ythick=3, charthick=3, $
		      ;type=3, xrange=[1e5, xmax], $
		      yrange=[ymin, ymax]
	  endif else begin
		  oploterror, Mlum3[index], N_tot3[index], d_Mlum3[index], yerr, $
		      psym=3, color='red', $
		      xtitle='M/M'+sunsymbol(), $
		      ytitle='N (M$\prime$>M)', $
		      hatlength=!D.X_VSIZE / 200., errthick = 2.0, errcolor='gray', $
		      charsize = 2.0, xthick=3, ythick=3, charthick=3, $
		      type=3, xrange=[1e5, xmax], $
		      yrange=[ymin, ymax]
	  endelse
	  plotsym, 0, 0.7, /fill
	  ;loadct, 33, /silent
	  ;oplot, Mlum3[index], N_tot3[index], psym=8, color=220
	  ;loadct, 0, /silent
	
	  loadct, 33, /silent
      xarr3 = findgen(1e5)/1e5*(alog10(xmax)-4.4)+4.4
	  yarr3 = truncated_mass_function(xarr3, trunc_result3)
	  oplot, 10.^xarr3, 10.^yarr3, linestyle=0, thick=linethick, color=220
	  notrunc_yarr3 = notruncated_mass_function(xarr3, notrunc_result3[1:2])
	  oplot, 10.^xarr3, 10.^notrunc_yarr3, linestyle=2, $
			color=220, thick=linethick
	  loadct, 0, /silent
  endif

  ; 4) PLOT ALL THE POINTS AGAIN
  index=where((Mlum0 gt 0) and (N_tot0 gt 0), ct)
  symsize = 1.5
  oplot, Mlum0[index], N_tot0[index], psym=8, symsize=symsize
  if n_elements(inner_pc) gt 0 then begin
    loadct, 33, /silent
    index=where((Mlum1 gt 0) and (N_tot1 gt 0), ct)
    oplot, Mlum1[index], N_tot1[index], psym=8, color=19, symsize=symsize
    loadct, 0, /silent
  endif

  if n_elements(ring_pc) gt 0 then begin
    loadct, 33, /silent
	index=where((Mlum2 gt 0) and (N_tot2 gt 0), ct)
	oplot, Mlum2[index], N_tot2[index], psym=8, color=cgColor('dark green'),$
		symsize = symsize
    loadct, 0, /silent
  endif

  if n_elements(outer_pc) gt 0 then begin
    loadct, 33, /silent
	index=where((Mlum3 gt 0) and (N_tot3 gt 0), ct)
	oplot, Mlum3[index], N_tot3[index], psym=8, color=220, symsize = symsize
    loadct, 0, /silent
  endif
  

  ; 5) LEGEND
  if keyword_set(notrunc) gt 0 then begin
	  cglegend,title=['trunc', 'non-trunc'], psym=[0,0], $
		  symsize=1, color=['blue','blue'], location=[0.68, 0.93], $
		  length=0.07, linestyle=[0,2], thick=4.,$
		  VSpace=1.5, charsize=1.2, charthick=5.0
  endif else begin
	  cglegend,title=['trunc'], psym=[0], $
		  symsize=1, color=['blue'], location=[0.68, 0.90], $
		  length=0.07, linestyle=[0], thick=4.,$
		  VSpace=1.5, charsize=1.2, charthick=5.0
  endelse
  title=['all data']
  psym=[16]
  color=['black']
  if n_elements(inner_pc) gt 0 then begin
	  title=[title,'inner']
	  psym=[psym,16]
	  color=[color,'blue']
  endif
  if n_elements(ring_pc) gt 0 then begin
	  title=[title,'intermediate']
	  psym=[psym,16]
	  color=[color,'dark green']
  endif
  if n_elements(outer_pc) gt 0 then begin
	  title=[title,'outer']
	  psym=[psym,16]
	  color=[color,'red']
  endif
  cglegend,title=title, psym=psym, $
	  symsize=1.2, color=color, location=[0.69, 0.85], $
	  length= 0.0, linestyle=2, $
	  VSpace=1.5, charsize=1.2, charthick=5.0

  device, /close_file
  set_plot, 'X'

end
